# 値はローカルの .env / .env.prod に置く。このファイルは名前と開発用の例だけ。
# Git に実キーや本番接続先を書かない。
# 使い方（開発）: cp .env.example .env
# 使い方（本番相当）: cp .env.example .env.prod のあと、下記「本番 Compose」を埋める

DATABASE_URL=ecto://postgres:postgres@db:5432/docker_bitflyer_dev
# 任意。未設定時は MIX_ENV=test で DATABASE_URL の DB 名を *_test に寄せる（例: docker_bitflyer_test）
# TEST_DATABASE_URL=ecto://postgres:postgres@db:5432/docker_bitflyer_test
SECRET_KEY_BASE=change_me_generate_with_mix_phx_gen_secret
PHX_HOST=localhost
# dry_run（既定）: 出さない・擬似約定しない。paper: 擬似約定。live: 実発注。
# 許可値以外は起動失敗。live 単独では発注不可。
TRADE_MODE=dry_run
# live 解禁の二重確認。TRADE_MODE=live のとき、UTC 当日の YYYY-MM-DD を明示する。
# 例: BITFLYER_LIVE_CONFIRM=2026-09-08
# BITFLYER_LIVE_CONFIRM=

# bitFlyer Private API（TRADE_MODE=live のとき必須。dry_run / paper では省略可）
# Lightning → 開発者ページで発行。値は .env のみ。Git・イメージ・ログに出さない。
# 権限: 資産参照・トレードに必要なものだけ。出金 / 送付は付けない。
# BITFLYER_API_KEY=
# BITFLYER_API_SECRET=

# live 専用（TRADE_MODE=live・MIX_ENV!=test）。未設定は起動失敗。開発既定の 1BTC 等は使わない。
# BITFLYER_MAX_ORDER_SIZE=0.01
# BITFLYER_MAX_POSITION_SIZE=0.01
# BITFLYER_MAX_DAILY_LOSS=10000
# BITFLYER_MAX_DAILY_DRAWDOWN_JPY=10000
# BITFLYER_MAX_ORDERS_PER_MINUTE=5
# BITFLYER_MAX_PRICE_DEVIATION_PCT=1
# 戦略は既定オフ。FixedOnce は live で有効化不可。承認済み module を config に置いたうえで:
# BITFLYER_STRATEGY_ENABLED=true

# live 初回 BalanceSnapshot baseline import の操作者（mix bitflyer.baseline 必須）
# BITFLYER_BASELINE_OPERATOR=alice

# submission_unknown 回収の操作者（mix bitflyer.recover 必須）
# BITFLYER_RECOVER_OPERATOR=alice

# Discord Incoming Webhook（任意）。未設定でも起動する。Bot は不要。
# チャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# paper 擬似約定の不利化（1 bps = 0.01%）。未設定時は config.exs 既定（slippage 5 / fee 15）。
# 成行: LTP に slippage+fee。指値交差後: 指値に fee のみ（スリッページ無し）。
# PAPER_SLIPPAGE_BPS=5
# PAPER_FEE_BPS=15

# UI BasicAuth（Status / locale / /ops/dashboard）。prod は必須。dev は両方揃ったときだけ有効。
# /health* は認証不要。値は .env のみ。Git に実パスワードを書かない。
# UI_BASIC_AUTH_USERNAME=
# UI_BASIC_AUTH_PASSWORD=

# 本番 metrics ConsoleReporter（未設定時は MIX_ENV=prod のみオン）。false で明示オフ。
# tick / Phoenix / VM は出さない（低頻度ドメインのみ）。ノイズ時は false。
# UI_METRICS_CONSOLE=

# 本番 HTTP bind（prod のみ）。Compose 本番はコンテナ内 0.0.0.0 + ホスト 127.0.0.1 公開が既定。
# 許可: 127.0.0.1 / 0.0.0.0 / ::1 / ::
# PHX_HTTP_IP=127.0.0.1

# MIX_ENV は書かない。.env 経由で固定すると mix precommit の preferred_envs が効かない。

# Compose の db サービスと揃える（任意。compose.yaml 側にも同値の既定がある）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docker_bitflyer_dev

# ---- 本番 Compose（compose.prod.yaml / .env.prod）----
# TRADE_MODE の検証既定は dry_run。live は prod.md のチェックリスト後。
# SECRET_KEY_BASE は mix phx.gen.secret で生成し直す。
# UI_BASIC_AUTH_USERNAME / UI_BASIC_AUTH_PASSWORD は必須（欠落時は起動失敗）。
# DATABASE_URL 例: ecto://postgres:CHANGE_ME@db:5432/docker_bitflyer_prod
# POSTGRES_DB=docker_bitflyer_prod
# POSTGRES_PASSWORD=CHANGE_ME
# digest 固定例（CD 後）:
# APP_IMAGE=ghcr.io/frick-eldy/docker-bitflyer@sha256:...
